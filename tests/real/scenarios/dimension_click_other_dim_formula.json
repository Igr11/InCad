{
 "name": "dimension_click_other_dim_formula",
 "steps": [
  "setup:rect_sketch_open",
  "wait:1.5",
  "cmd:sketch.dimension",
  "move:bottom",
  "click:bottom",
  "move:bottom_place",
  "click:bottom_place",
  "wait:0.5",
  "memo:d0=s['box']['name']",
  "move:away",
  "type:30",
  "keys:36",
  "wait:1.5",
  "expect:[m['d0'], 30.0] in s['dims'] and s['box'] is None",
  "move:left",
  "click:left",
  "move:left_place",
  "click:left_place",
  "wait:0.8",
  "expect:s['box'] is not None",
  "memo:d1=s['box']['name']",
  "move:away",
  "move:label.{m[d0]}",
  "click:label.{m[d0]}",
  "wait:0.5",
  "expect:s['box'] is not None and s['box']['text'] == m['d0'] and s['focus'] == 'QLineEdit'",
  "type:/2",
  "expect:s['box']['text'] == m['d0'] + '/2'",
  "keys:36",
  "wait:1.5",
  "expect:s['box'] is None and [m['d1'], 15.0] in s['dims']",
  "keys:53"
 ]
}